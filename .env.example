# Navegador (públicas por diseño; la seguridad depende de las reglas RLS de Supabase)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon

# Servidor (Vercel → Settings → Environment Variables). Nunca en el navegador.
OPENAI_API_KEY=
# Opcional: emails autorizados a usar las APIs, separados por comas
ALLOWED_EMAILS=
# Opcional
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=1500
